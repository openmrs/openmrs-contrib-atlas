{
  "hosting": [
    {
      "target": "staging",
      "public": "web/dist",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "atlas-service-stg",
            "region": "us-central1"
          }
        }
      ],
      "redirects": [
        {
          "source": "/rss",
          "destination": "https://storage.googleapis.com/openmrs-atlas-stg/rss.xml",
          "type": 302
        },
        {
          "source": "/data/atlas.json",
          "destination": "https://storage.googleapis.com/openmrs-atlas-stg/atlas.json",
          "type": 302
        },
        {
          "source": "/data/markers.csv",
          "destination": "https://storage.googleapis.com/openmrs-atlas-stg/markers.csv",
          "type": 302
        },
        {
          "source": "/data/markers.geojson",
          "destination": "https://storage.googleapis.com/openmrs-atlas-stg/markers.geojson",
          "type": 302
        }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/reminder{,.html}",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            }
          ]
        }
      ]
    },
    {
      "target": "production",
      "public": "web/dist",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "atlas-service",
            "region": "us-central1"
          }
        }
      ],
      "redirects": [
        {
          "source": "/rss",
          "destination": "https://storage.googleapis.com/openmrs-atlas/rss.xml",
          "type": 302
        },
        {
          "source": "/data/atlas.json",
          "destination": "https://storage.googleapis.com/openmrs-atlas/atlas.json",
          "type": 302
        },
        {
          "source": "/data/markers.csv",
          "destination": "https://storage.googleapis.com/openmrs-atlas/markers.csv",
          "type": 302
        },
        {
          "source": "/data/markers.geojson",
          "destination": "https://storage.googleapis.com/openmrs-atlas/markers.geojson",
          "type": 302
        }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/reminder{,.html}",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            }
          ]
        }
      ]
    }
  ]
}
