# Settings for `bash infra/setup.sh staging`. See infra/README.md.
PROJECT=atlas-stg-513316
REGION=us-central1
BUCKET=openmrs-atlas-stg # firebase.json's staging redirects name this bucket
SERVICE=atlas-service-stg # and its /api rewrite this service
SITE_ORIGIN=https://atlas-stg.openmrs.org
HOSTING_TARGET=staging
KEYCLOAK_ISSUER=https://id-stg.openmrs.org/realms/openmrs
# Only pushes to main may deploy.
WIF_CONDITION="assertion.repository=='openmrs/openmrs-contrib-atlas' && assertion.ref=='refs/heads/main'"
PAUSE_NEW_REMINDER_JOB=no
