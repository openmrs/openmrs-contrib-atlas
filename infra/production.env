# Settings for `bash infra/setup.sh production`. See infra/README.md.
PROJECT=openmrs-atlas
REGION=us-central1
BUCKET=openmrs-atlas # firebase.json's production redirects name this bucket
SERVICE=atlas-service # and its /api rewrite this service
SITE_ORIGIN=https://atlas.openmrs.org
HOSTING_TARGET=production
KEYCLOAK_ISSUER=https://id.openmrs.org/realms/openmrs
# Only the production environment, which GitHub grants only to approved release tags, may deploy.
WIF_CONDITION="assertion.repository=='openmrs/openmrs-contrib-atlas' && assertion.environment=='production' && assertion.ref_type=='tag'"
# No reminders before the cutover; the checklist in infra/README.md resumes the job.
PAUSE_NEW_REMINDER_JOB=yes
